---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { profile } from "../content/profile";

const title = `Writing on Data Engineering by ${profile.name}`;
const description = `Articles by ${profile.name} on Apache Iceberg, DataHub, Airbyte and data platform engineering, published on Towards Data Engineering.`;
---

<BaseLayout title={title} description={description}>
  <section class="section" id="writing">
    <h1 class="section-label"><Icon name="pen-line" size={14} />Writing</h1>
    <ul class="writing-list">
      {profile.writing.map((post) => (
        <li>
          <a class="writing-row" href={post.url} target="_blank" rel="noopener noreferrer">
            <Icon name="file-text" size={16} class="writing-lead" />
            <span class="writing-row-title">{post.title}</span>
            <Icon name="arrow-up-right" size={16} class="ext" />
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="writing-actions">
      <a class="writing-all" href="/">
        <Icon name="arrow-right" size={14} class="flip" /> Back to home
      </a>
      <a class="writing-all" href={profile.links.medium} target="_blank" rel="noopener noreferrer">
        All posts on Medium <Icon name="arrow-up-right" size={14} />
        <span class="sr-only">(opens in new tab)</span>
      </a>
    </div>
  </section>
</BaseLayout>
