---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Page not found · Aman Ranjan Verma" description="This page does not exist." noindex>
  <section class="section not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <div class="hero-links">
      <a class="hero-link primary" href="/"><Icon name="arrow-right" size={14} class="flip" />Back to home</a>
      <a class="hero-link" href="/writing/"><Icon name="pen-line" size={15} />Writing</a>
      <a class="hero-link" href="/#projects"><Icon name="rocket" size={15} />Hobby Projects</a>
    </div>
  </section>
</BaseLayout>
