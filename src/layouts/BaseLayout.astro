---
import "@fontsource-variable/inter";
import "@fontsource/roboto-mono/400.css";
import "@fontsource/roboto-mono/500.css";
import "../styles/global.css";
import { profile } from "../content/profile";
import { withBase } from "../lib/paths";
import ResumeModal from "../components/ResumeModal.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep out of search results (e.g. the 404 page): adds robots noindex and drops the canonical. */
  noindex?: boolean;
}

const {
  title = `${profile.name} · Senior Data Engineer`,
  description = "Senior Data Engineer specializing in data platforms, pipelines, and infrastructure.",
  image = "og-image.png",
  imageAlt = "Illustration of Aman Ranjan Verma with the line I build data platforms. Then I write about what works.",
  jsonLd,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isWriting = path.startsWith("/writing");
const isProject = path.startsWith("/projects");
const imageURL = new URL(image, Astro.site).href;
const structuredData = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex" />
      : <link rel="canonical" href={canonicalURL} />}
    <meta name="author" content={profile.name} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-627F8634JW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-627F8634JW');
    </script>
    <!-- Apply saved theme before render to prevent flash -->
    <script is:inline>
      (function() {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        document.documentElement.setAttribute('data-theme', saved === 'light' ? 'light' : 'dark');
        if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href={`${canonicalURL}#main`}>Skip to content</a>
    <div class="page">
      <nav class="nav" aria-label="Primary">
        <a class="nav-logo" href="/"><Icon name="code" size={15} />arverma.dev</a>
        <div class="nav-right">
          <div class="nav-links">
            <a href="/#work" data-spy="work"><Icon name="briefcase" size={14} /><span>Work</span></a>
            <a href="/#projects" data-spy="projects" aria-current={isProject ? "true" : undefined}><Icon name="rocket" size={14} /><span>Hobby Projects</span></a>
            <a href="/#skills" data-spy="skills"><Icon name="layers" size={14} /><span>Skills</span></a>
            <a href="/writing/" data-spy="writing" aria-current={isWriting ? "page" : undefined}><Icon name="pen-line" size={14} /><span>Writing</span></a>
          </div>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch to light theme">
            <Icon name="sun" size={16} class="theme-toggle__sun" />
            <Icon name="moon" size={16} class="theme-toggle__moon" />
          </button>
        </div>
      </nav>

      <main id="main">
        <slot />
      </main>

      <footer class="footer">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span class="footer-loc"><Icon name="map-pin" size={13} />Remote · India</span>
      </footer>
    </div>

    <ResumeModal />

    <script>
      const toggle = document.getElementById('theme-toggle');

      function getTheme() {
        return document.documentElement.getAttribute('data-theme') || 'dark';
      }

      // Icon visibility is pure CSS (driven by data-theme); JS only keeps the
      // accessible name in sync so it always describes the *next* action.
      function syncLabel() {
        const next = getTheme() === 'dark' ? 'light' : 'dark';
        const label = `Switch to ${next} theme`;
        toggle?.setAttribute('aria-label', label);
        toggle?.setAttribute('title', label);
      }

      function setTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        try { localStorage.setItem('theme', theme); } catch {}
        syncLabel();
      }

      // ── Scroll-spy (home page only): mark the nav link for the section in view.
      const spyLinks = document.querySelectorAll('.nav-links a[data-spy]');
      const sections = ['work', 'projects', 'skills', 'writing']
        .map((id) => document.getElementById(id))
        .filter(Boolean);
      if (sections.length && 'IntersectionObserver' in window) {
        const setActive = (id) => {
          spyLinks.forEach((a) => {
            if (a.dataset.spy === id) a.setAttribute('aria-current', 'location');
            else if (a.getAttribute('aria-current') === 'location') a.removeAttribute('aria-current');
          });
        };
        const visible = new Set();
        const spy = new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
          // Topmost visible section wins; none visible (hero) clears the state.
          setActive(sections.find((s) => visible.has(s.id))?.id);
        }, { rootMargin: '-30% 0px -60% 0px' });
        sections.forEach((s) => spy.observe(s));
      }

      // ── Scroll reveal: only runs when <html class="js"> (set in <head>, absent
      // for reduced-motion users), so content is always visible without JS.
      if (document.documentElement.classList.contains('js') && 'IntersectionObserver' in window) {
        const targets = document.querySelectorAll('.work-item, .project-grid > li, .skill-group, .writing-row, .project-page > *');
        const seen = new Map();
        const reveal = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-visible');
            reveal.unobserve(e.target);
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -5% 0px' });
        targets.forEach((el) => {
          const parent = el.parentElement;
          const i = seen.get(parent) ?? 0;
          seen.set(parent, i + 1);
          el.style.setProperty('--d', `${Math.min(i, 6) * 60}ms`);
          reveal.observe(el);
        });
      }

      syncLabel();
      toggle?.addEventListener('click', () => {
        setTheme(getTheme() === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
