---
import { profile } from "../content/profile";
import Sticker from "./Sticker.astro";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="section-head">
    <div>
      <p class="section-label">About</p>
      <h2 class="section-title" id="about-title">Who I am</h2>
      <p class="section-lede">
        Platforms, pipelines, and the quiet craft of making data usable.
      </p>
    </div>
    <Sticker src="/stickers/diary.svg" size="sm" tilt="right" />
  </div>

  <div class="about-grid">
    <div class="about-prose">
      {profile.about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <ul class="about-highlights">
      {
        profile.about.highlights.map((item) => (
          <li>
            <span class="tick mono" aria-hidden="true">
              ›
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .about-prose p {
    margin: 0 0 1rem;
    max-width: 38rem;
  }

  .about-prose p:last-child {
    margin-bottom: 0;
  }

  .about-highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .about-highlights li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-muted);
    font-size: 0.98rem;
  }

  .tick {
    color: var(--teal);
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
