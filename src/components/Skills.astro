---
import { profile } from "../content/profile";

const allSkills = Object.values(profile.skills).flat();
---

<section class="section" id="skills">
  <p class="section-label">Skills</p>
  <div class="skills-flat">
    {allSkills.map((skill) => (
      <span class="skill-chip">{skill}</span>
    ))}
  </div>
</section>
