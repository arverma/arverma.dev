---
import { profile } from "../content/profile";
import Sticker from "./Sticker.astro";
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="section-head">
    <div>
      <p class="section-label">Contact</p>
      <h2 class="section-title" id="contact-title">Say hello</h2>
      <p class="section-lede">
        Open to remote roles and thoughtful conversations about data platforms.
      </p>
    </div>
    <div class="section-stickers" aria-hidden="true">
      <Sticker src="/stickers/cloud-sun.svg" size="sm" tilt="right" />
      <Sticker src="/stickers/music-note.svg" size="sm" tilt="left" />
    </div>
  </div>

  <div class="contact-panel">
    <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
    <div class="btn-row contact-actions">
      <a class="btn btn-primary" href={`mailto:${profile.email}`}>Email me</a>
      <a
        class="btn btn-ghost"
        href={profile.links.resume}
        target="_blank"
        rel="noopener noreferrer">View resume</a
      >
    </div>
    <ul class="contact-links mono">
      <li>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
      </li>
      <li>
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
      </li>
      <li>
        <a href={profile.links.medium} target="_blank" rel="noopener noreferrer"
          >Medium</a
        >
      </li>
    </ul>
  </div>
</section>

<style>
  .contact-panel {
    max-width: 36rem;
  }

  .contact-email {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--teal);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .contact-email:hover {
    color: var(--teal-deep);
    border-bottom-color: var(--teal-deep);
  }

  .contact-actions {
    margin-top: 1.5rem;
  }

  .contact-links {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    font-size: 0.85rem;
  }

  .contact-links a {
    text-decoration: none;
    color: var(--ink-muted);
    border-bottom: 1px solid transparent;
  }

  .contact-links a:hover {
    color: var(--teal-deep);
    border-bottom-color: var(--teal);
  }
</style>
