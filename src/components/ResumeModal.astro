---
import Icon from "./Icon.astro";
---

<dialog class="lp-dialog" id="lp-dialog" aria-modal="true" aria-label="Resume">
  <div class="lp-panel">
    <div class="lp-header">
      <span class="lp-label">Resume</span>
      <div class="lp-controls">
        <a class="lp-btn" href="/resume.pdf" download="Aman-Ranjan-Verma-Resume.pdf">
          <Icon name="download" size={13} />Download<span class="lp-btn-long">&nbsp;PDF</span>
        </a>
        <button class="lp-close" id="lp-close" type="button" aria-label="Close dialog" title="Close">
          <Icon name="x" size={14} />
        </button>
      </div>
    </div>

    <!-- Pages are drawn here as canvases, sized to the available width. -->
    <div class="lp-scroll" id="lp-scroll" tabindex="0" aria-label="Resume pages. Pinch or use browser zoom to enlarge.">
      <div class="lp-loading" id="lp-loading" role="status">
        <div class="lp-spinner"></div>
        <span class="sr-only">Loading resume</span>
      </div>
      <p class="lp-error" id="lp-error" hidden>
        The preview could not load.
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">
          Open the PDF<Icon name="arrow-up-right" size={13} /><span class="sr-only">(opens in new tab)</span>
        </a>
      </p>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lp-dialog') as HTMLDialogElement;
  const scroller = document.getElementById('lp-scroll') as HTMLElement;
  const loadingEl = document.getElementById('lp-loading') as HTMLElement;
  const errorEl = document.getElementById('lp-error') as HTMLElement;
  const closeBtn = document.getElementById('lp-close') as HTMLButtonElement;

  const PDF_URL = '/resume.pdf';
  let rendered: Promise<void> | undefined;

  // PDF.js is ~1 MB, so it is only fetched the first time the dialog opens.
  async function renderPdf() {
    const [pdfjs, worker] = await Promise.all([
      import('pdfjs-dist'),
      import('pdfjs-dist/build/pdf.worker.min.mjs?url'),
    ]);
    pdfjs.GlobalWorkerOptions.workerSrc = worker.default;

    const pdf = await pdfjs.getDocument({ url: PDF_URL }).promise;
    // Oversample so pages stay sharp when the reader pinch-zooms (capped for memory).
    const quality = Math.min(Math.max(window.devicePixelRatio || 1, 2) * 1.5, 4);

    for (let n = 1; n <= pdf.numPages; n++) {
      const page = await pdf.getPage(n);
      const base = page.getViewport({ scale: 1 });
      const pad = parseFloat(getComputedStyle(scroller).paddingLeft) * 2;
      const cssWidth = scroller.clientWidth - pad;
      const viewport = page.getViewport({ scale: (cssWidth / base.width) * quality });

      const canvas = document.createElement('canvas');
      canvas.className = 'lp-page';
      canvas.width = Math.floor(viewport.width);
      canvas.height = Math.floor(viewport.height);
      canvas.setAttribute('role', 'img');
      canvas.setAttribute('aria-label', `Resume page ${n} of ${pdf.numPages}`);
      await page.render({ canvas, viewport }).promise;
      scroller.appendChild(canvas);
      loadingEl.hidden = true;
    }
  }

  function openModal() {
    document.body.classList.add('lp-open');
    dialog.showModal();
    if (!rendered) {
      loadingEl.hidden = false;
      errorEl.hidden = true;
      rendered = renderPdf().catch((error) => {
        console.error('Resume preview failed:', error);
        rendered = undefined; // allow a retry next time
        loadingEl.hidden = true;
        errorEl.hidden = false;
      });
    }
  }

  function closeModal() {
    if (dialog.open) dialog.close();
  }

  // 'close' fires for every route (button, backdrop, native Esc), keeping state in sync.
  dialog.addEventListener('close', () => document.body.classList.remove('lp-open'));
  closeBtn.addEventListener('click', closeModal);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) closeModal(); });

  document.querySelectorAll('[data-resume-open]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });
  });
</script>

<style is:global>
  body.lp-open { overflow: hidden; }

  /* ── Dialog centering ───────────────────────────────── */
  .lp-dialog {
    padding: 0;
    border: none;
    background: transparent;
    width: calc(100% - 2rem);
    max-width: 43rem;
    max-height: calc(100dvh - 4rem);
    overflow: visible;
    /* DO NOT set display here — browser hides dialog by default */
  }

  /* Center the dialog when it's open */
  .lp-dialog[open] {
    position: fixed;
    inset: 0;
    margin: auto;
  }

  .lp-dialog::backdrop {
    background:
      radial-gradient(ellipse 70% 40% at 50% 0%, rgba(124, 106, 255, 0.1), transparent),
      rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* ── Panel ──────────────────────────────────────────── */
  .lp-panel {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04) inset,
      0 32px 72px rgba(0,0,0,0.6),
      0 8px 20px rgba(0,0,0,0.3);
    overflow: hidden;
    max-height: calc(100dvh - 4rem);
    animation: lp-enter 0.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes lp-enter {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ── Header ─────────────────────────────────────────── */
  .lp-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--rule);
    flex-shrink: 0;
  }

  .lp-meta { min-width: 0; }

  .lp-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.1rem;
  }


  .lp-controls {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
  }

  .lp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    padding: 0.28rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    color: var(--ink-2);
    text-decoration: none;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    white-space: nowrap;
  }

  .lp-btn {
    background: var(--brand);
    border-color: var(--on-brand);
    color: var(--on-brand);
    font-weight: 600;
  }

  .lp-btn:hover {
    background: var(--brand);
    filter: brightness(1.08);
    box-shadow: 2px 2px 0 var(--btn-shadow);
    opacity: 1;
  }

  .lp-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    flex-shrink: 0;
  }

  .lp-close:hover {
    border-color: var(--brand);
    color: var(--on-brand);
    background: var(--brand);
  }

  /* ── Pages ───────────────────────────────────────────── */
  .lp-scroll {
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y pinch-zoom;
    background: color-mix(in srgb, var(--ink) 8%, var(--bg));
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
  }
  .lp-page {
    display: block;
    width: 100%;
    height: auto;
    background: #fff;
    border-radius: 4px;
    box-shadow: 0 2px 14px rgba(0,0,0,0.25);
  }
  .lp-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40vh;
  }
  .lp-loading[hidden], .lp-error[hidden] { display: none; }
  .lp-error { color: var(--ink-2); text-align: center; padding: 2rem 1rem; }
  .lp-error a { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--accent); }
  .lp-btn-long { display: inline; }

  .lp-spinner {
    width: 1.4rem;
    height: 1.4rem;
    border: 2px solid var(--rule);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: lp-spin 0.65s linear infinite;
  }
  @keyframes lp-spin { to { transform: rotate(360deg); } }

  /* ── Mobile: full-screen so the A4 page gets the whole width ── */
  @media (max-width: 640px) {
    .lp-dialog {
      width: 100%;
      max-width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      inset: 0;
      margin: 0;
    }
    .lp-panel {
      height: 100dvh;
      max-height: 100dvh;
      border: 0;
      border-radius: 0;
      animation: lp-sheet-up 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .lp-scroll { padding: 8px; gap: 8px; }
    .lp-btn-long { display: none; }
    @keyframes lp-sheet-up {
      from { transform: translateY(100%); opacity: 0.6; }
      to   { transform: translateY(0); opacity: 1; }
    }
  }
</style>

