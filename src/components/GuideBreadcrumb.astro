---
interface Props {
  current: string;
}

const { current } = Astro.props;
---

<nav class="guide-breadcrumb" aria-label="Breadcrumb">
  <ol class="guide-breadcrumb__list">
    <li><a href="/">Home</a></li>
    <li><a href="/guides/">Guides</a></li>
    <li aria-current="page">{current}</li>
  </ol>
</nav>

<style>
  .guide-breadcrumb {
    margin-bottom: 1rem;
  }

  .guide-breadcrumb__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .guide-breadcrumb__list li:not(:last-child)::after {
    content: "/";
    margin-left: 0.45rem;
    color: var(--ink-3);
  }

  .guide-breadcrumb__list a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .guide-breadcrumb__list a:hover {
    color: var(--accent);
  }

  .guide-breadcrumb__list [aria-current="page"] {
    color: var(--ink-3);
  }
</style>
