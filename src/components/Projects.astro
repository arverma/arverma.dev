---
import { profile } from "../content/profile";
import Icon from "./Icon.astro";
---

<section class="section" id="projects">
  <h2 class="section-label"><Icon name="rocket" size={14} />Hobby Projects</h2>
  <ul class="project-grid">
    {profile.liveProjects.map((p) => (
      <li>
        <a class="project-card" href={p.url} target="_blank" rel="noopener noreferrer">
          <span class="project-card__icon">
            <Icon name={p.icon} size={20} />
          </span>
          <span class="project-card__body">
            <span class="project-card__head">
              <span class="project-card__name">{p.name}</span>
              <span class="project-card__kind">
                {p.kind === "Chrome extension" && <Icon name="puzzle" size={11} />}
                {p.kind}
              </span>
            </span>
            <span class="project-card__desc">{p.description}</span>
          </span>
          <Icon name="arrow-up-right" size={16} class="ext" />
          <span class="sr-only">(opens in new tab)</span>
        </a>
        <a class="project-details" href={`/projects/${p.slug}/`}>
          About {p.name} <Icon name="arrow-right" size={12} />
        </a>
      </li>
    ))}
  </ul>
  <div class="writing-actions">
    <a class="writing-all" href={profile.links.githubRepos} target="_blank" rel="noopener noreferrer">
      <Icon name="github" size={14} />See all projects on GitHub<Icon name="arrow-up-right" size={14} />
      <span class="sr-only">(opens in new tab)</span>
    </a>
  </div>
</section>
