---
import { profile } from "../content/profile";
import Sticker from "./Sticker.astro";
---

<section class="section projects" id="projects" aria-labelledby="projects-title">
  <div class="section-head">
    <div>
      <p class="section-label">Projects</p>
      <h2 class="section-title" id="projects-title">Open work on the desk</h2>
      <p class="section-lede">
        A few repos worth a look — tools, playgrounds, and platform experiments.
      </p>
    </div>
    <Sticker src="/stickers/sticky-note.svg" size="sm" tilt="right" />
  </div>

  <ul class="project-list">
    {
      profile.projects.map((project) => (
        <li class="project-row">
          <div class="project-main">
            <a
              class="project-name"
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.name}
            </a>
            <p class="project-desc">{project.description}</p>
          </div>
          <div class="project-side">
            <ul class="project-tags mono">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <a
              class="project-link mono"
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              github →
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-row {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr;
    gap: 1.25rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--rule);
    align-items: start;
  }

  .project-row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .project-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .project-name:hover {
    color: var(--teal-deep);
    border-bottom-color: var(--teal);
  }

  .project-desc {
    margin: 0.45rem 0 0;
    color: var(--ink-muted);
    max-width: 40rem;
  }

  .project-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.65rem;
  }

  .project-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
    font-size: 0.72rem;
  }

  .project-tags li {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 0.15rem;
    color: var(--ink-muted);
  }

  .project-link {
    font-size: 0.78rem;
    text-decoration: none;
    color: var(--teal-deep);
  }

  .project-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .project-row {
      grid-template-columns: 1fr;
    }

    .project-side {
      align-items: flex-start;
    }

    .project-tags {
      justify-content: flex-start;
    }
  }
</style>
