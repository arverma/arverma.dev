---
// Decorative butterfly: flutters around while the page scrolls, perches on the
// edge of a visible card/heading when scrolling stops. Purely cosmetic:
// aria-hidden, ignores pointer events, off for prefers-reduced-motion and print.
---

<div class="butterfly" id="butterfly" aria-hidden="true">
  <svg class="butterfly__svg" viewBox="0 0 40 32" width="38" height="30" focusable="false">
    <defs>
      <g id="bf-wing">
        <path class="bf-fore" d="M20 15 C22 4 32 0.5 37 5 C39.5 9 33 16 20 17 Z" />
        <path class="bf-hind" d="M20 17 C30 17 35.5 22 31.5 28 C28.5 31.5 22 26 20 19 Z" />
        <circle cx="31" cy="8.2" r="2" class="bf-spot" />
        <circle cx="27.5" cy="23" r="1.6" class="bf-spot" />
      </g>
    </defs>
    <g class="bf-wing bf-wing--l"><use href="#bf-wing" transform="translate(40 0) scale(-1 1)" /></g>
    <g class="bf-wing bf-wing--r"><use href="#bf-wing" /></g>
    <ellipse class="bf-body" cx="20" cy="17" rx="1.4" ry="7.5" />
    <path class="bf-feeler" d="M19.4 10 C18 6 16.5 4.5 15.5 4 M20.6 10 C22 6 23.5 4.5 24.5 4" />
  </svg>
</div>

<style>
  .butterfly {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: 38px;
    height: 30px;
    margin: -15px 0 0 -19px; /* transform origin = wing centre */
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    will-change: transform;
  }
  .butterfly.is-ready { opacity: 1; }
  .butterfly__svg { display: block; overflow: visible; }

  .bf-fore, .bf-hind { fill: #f5b800; stroke: #17171a; stroke-width: 1.3; stroke-linejoin: round; }
  .bf-hind { fill: #e8a300; }
  .bf-spot { fill: #6b3f1d; }
  .bf-body { fill: #3b2412; stroke: #17171a; stroke-width: 0.8; }
  .bf-feeler { fill: none; stroke: #17171a; stroke-width: 0.9; stroke-linecap: round; }

  .bf-wing { transform-box: view-box; transform-origin: 20px 16px; animation: bf-flap 0.16s ease-in-out infinite alternate; }
  .butterfly.is-resting .bf-wing { animation: bf-rest 3.2s ease-in-out infinite; }
  .butterfly.is-resting .bf-wing--l { animation-delay: 0.04s; }

  @keyframes bf-flap { from { transform: scaleX(1); } to { transform: scaleX(0.22); } }
  /* Wings mostly closed, with an occasional slow open. */
  @keyframes bf-rest {
    0%, 70%, 100% { transform: scaleX(0.38); }
    80% { transform: scaleX(0.85); }
    90% { transform: scaleX(0.38); }
  }

  @media (prefers-reduced-motion: reduce) { .butterfly { display: none; } }
  @media print { .butterfly { display: none; } }
</style>

<script>
  const el = document.getElementById("butterfly") as HTMLElement | null;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (el && !reduce.matches) {
    const PERCH_SELECTOR =
      ".work-item, .project-card, .writing-pinned__link, .writing-row, .skill-group, .hero-link, .section-label, .hero-name";
    const REST_DELAY = 450; // ms after the last scroll event before landing
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    let x = rand(80, innerWidth - 80);
    let y = -40;
    let vx = 0;
    let vy = 0;
    let angle = 0; // degrees
    let target = { x, y };
    let mode: "perched" | "flying" | "landing" = "perched";
    let raf = 0;
    let restTimer = 0;
    let wanderAt = 0;
    let t0 = performance.now();

    const render = () => {
      el.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${angle}deg)`;
    };

    const setResting = (resting: boolean) => el.classList.toggle("is-resting", resting);

    // A point on the top edge of a visible element, so it looks like sitting on it.
    const pickPerch = () => {
      const margin = 24;
      const candidates = [...document.querySelectorAll<HTMLElement>(PERCH_SELECTOR)]
        .map((n) => n.getBoundingClientRect())
        .filter(
          (r) =>
            r.width > 60 &&
            r.top > margin + 56 && // keep clear of the sticky nav
            r.top < innerHeight - 96 && // keep clear of the bottom dock on phones
            r.left < innerWidth - margin &&
            r.right > margin,
        );
      if (!candidates.length) return { x: rand(40, innerWidth - 40), y: rand(120, innerHeight - 110) };
      const r = candidates[Math.floor(Math.random() * candidates.length)];
      const left = Math.max(r.left, margin) + 12;
      const right = Math.min(r.right, innerWidth - margin) - 12;
      return { x: rand(left, Math.max(left, right)), y: r.top - 2 };
    };

    const wanderPoint = () => ({ x: rand(30, innerWidth - 30), y: rand(80, innerHeight - 40) });

    const step = (now: number) => {
      const dt = Math.min((now - t0) / 16.67, 3);
      t0 = now;

      if (mode === "flying" && now > wanderAt) {
        target = wanderPoint();
        wanderAt = now + rand(500, 1100);
      }

      const dx = target.x - x;
      const dy = target.y - y;
      const dist = Math.hypot(dx, dy) || 1;
      const speed = mode === "landing" ? Math.min(5.5, 0.6 + dist * 0.07) : 4.2;
      // Steer toward the target with a little sinusoidal flutter.
      const wobble = mode === "flying" ? Math.sin(now / 140) * 1.1 : Math.sin(now / 200) * Math.min(dist / 80, 1);
      const nx = (dx / dist) * speed - (dy / dist) * wobble;
      const ny = (dy / dist) * speed + (dx / dist) * wobble;
      vx += (nx - vx) * 0.14 * dt;
      vy += (ny - vy) * 0.14 * dt;
      x += vx * dt;
      y += vy * dt;

      if (Math.hypot(vx, vy) > 0.6) {
        const heading = (Math.atan2(vy, vx) * 180) / Math.PI + 90;
        let diff = ((heading - angle + 540) % 360) - 180;
        angle += diff * 0.12 * dt;
      }

      if (mode === "landing" && dist < 2.5) {
        mode = "perched";
        vx = vy = 0;
        x = target.x;
        y = target.y;
        // Settle facing a slightly random direction, wings closing.
        angle = rand(-25, 25);
        setResting(true);
        render();
        raf = 0;
        return;
      }
      render();
      raf = requestAnimationFrame(step);
    };

    const run = () => {
      if (!raf) {
        t0 = performance.now();
        raf = requestAnimationFrame(step);
      }
    };

    const onScroll = () => {
      if (mode !== "flying") {
        mode = "flying";
        setResting(false);
        target = wanderPoint();
        wanderAt = performance.now() + rand(500, 1100);
        run();
      }
      clearTimeout(restTimer);
      restTimer = window.setTimeout(() => {
        mode = "landing";
        target = pickPerch();
        run();
      }, REST_DELAY);
    };

    // Entrance: fade in perched on something visible once the page has settled.
    const start = () => {
      const p = pickPerch();
      x = p.x;
      y = p.y;
      angle = rand(-25, 25);
      setResting(true);
      render();
      el.classList.add("is-ready");
    };

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", () => {
      if (mode === "perched") {
        mode = "landing";
        target = pickPerch();
        run();
      }
    });
    reduce.addEventListener("change", () => {
      if (reduce.matches) {
        cancelAnimationFrame(raf);
        raf = 0;
        clearTimeout(restTimer);
      }
    });
    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>
