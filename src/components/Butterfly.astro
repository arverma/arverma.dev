---
// Decorative butterfly: flutters around while the page scrolls, perches on the
// edge of a visible card/heading when scrolling stops. Purely cosmetic:
// aria-hidden, ignores pointer events, off for prefers-reduced-motion and print.
// Drawn side-on, facing right; JS mirrors it to face its direction of travel.
---

<div class="butterfly" id="butterfly" aria-hidden="true">
  <svg class="butterfly__svg" id="butterfly-svg" viewBox="0 0 120 108" width="56" height="50" focusable="false">
    <defs>
      <radialGradient id="bf-fore" cx="0.92" cy="0.95" r="1.05">
        <stop offset="0" stop-color="#fff0b0" />
        <stop offset="0.3" stop-color="#ffd62e" />
        <stop offset="0.75" stop-color="#f9b400" />
        <stop offset="1" stop-color="#e08a00" />
      </radialGradient>
      <radialGradient id="bf-hind" cx="0.95" cy="0.08" r="1.1">
        <stop offset="0" stop-color="#fff6cf" />
        <stop offset="0.38" stop-color="#ffe27a" />
        <stop offset="0.8" stop-color="#fbbd0a" />
        <stop offset="1" stop-color="#e9960a" />
      </radialGradient>
      <linearGradient id="bf-far" x1="0" y1="1" x2="0.4" y2="0">
        <stop offset="0" stop-color="#f7b500" />
        <stop offset="1" stop-color="#ffe24d" />
      </linearGradient>
    </defs>

    <!-- far wing, raised behind the body -->
    <g class="bf-wing bf-wing--far">
      <path class="bf-edge" fill="url(#bf-far)" d="M90 58 C93 40 99 22 107 10 C111 5 116 9 114 21 C111 38 101 52 93 62 Z" />
      <path class="bf-vein" d="M91 58 C98 42 104 26 110 14 M92 60 C101 46 108 32 113 20" />
    </g>

    <!-- legs and abdomen -->
    <g class="bf-legs">
      <path d="M92 70 L99 78 L105 90 M91 72 L96 83 L97 94 M89 74 L91 86 L89 97" />
    </g>
    <ellipse class="bf-abdomen" cx="86" cy="76" rx="2.7" ry="10" transform="rotate(14 86 76)" />

    <!-- near wings -->
    <g class="bf-wing bf-wing--near">
      <path class="bf-edge" fill="url(#bf-fore)" d="M88 60 C82 38 58 16 25 18 C14 19 9 29 14 41 C20 53 52 63 88 62 Z" />
      <path class="bf-edge" fill="url(#bf-hind)" d="M88 62 C60 57 25 62 17 77 C12 90 22 99 34 100 C42 103 50 101 56 98 C72 94 84 78 88 62 Z" />
      <path class="bf-vein" d="M87 60 C70 44 44 28 21 24 M87 60 C66 49 38 40 15 36 M87 61 C66 55 36 53 14 47 M87 62 C62 66 34 72 19 83 M87 63 C64 73 40 89 31 99 M87 63 C70 77 58 90 54 98" />
    </g>

    <!-- thorax, head, antennae -->
    <ellipse class="bf-thorax" cx="91" cy="64" rx="4.6" ry="6.2" />
    <circle class="bf-head" cx="96.5" cy="56.5" r="3.7" />
    <circle class="bf-eye" cx="97.6" cy="55.6" r="1.5" />
    <path class="bf-feeler" d="M98 53.5 C103 46 108 41 112.5 38 M100 54.5 C103 48 106 43 108.5 40.5" />
    <circle class="bf-club" cx="112.8" cy="37.8" r="1.5" />
    <circle class="bf-club" cx="108.7" cy="40.3" r="1.4" />
  </svg>
</div>

<style>
  .butterfly {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: 56px;
    height: 50px;
    margin: -25px 0 0 -28px; /* transform origin = centre of the wings */
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    will-change: transform;
  }
  .butterfly.is-ready { opacity: 1; }
  .butterfly__svg { display: block; overflow: visible; transition: transform 0.25s ease; filter: drop-shadow(0 1px 1px rgba(23, 23, 26, 0.18)); }

  .bf-edge { stroke: #7a4a12; stroke-width: 1.1; stroke-linejoin: round; }
  .bf-vein { fill: none; stroke: #b86f00; stroke-width: 0.6; stroke-linecap: round; opacity: 0.55; }
  .bf-legs path { fill: none; stroke: #6b4a14; stroke-width: 0.8; stroke-linecap: round; stroke-linejoin: round; }
  .bf-abdomen { fill: #f2c230; stroke: #7a4a12; stroke-width: 0.6; }
  .bf-thorax { fill: #e9b520; stroke: #7a4a12; stroke-width: 0.6; }
  .bf-head { fill: #f0c43a; stroke: #7a4a12; stroke-width: 0.6; }
  .bf-eye { fill: #17171a; }
  .bf-feeler { fill: none; stroke: #3b2412; stroke-width: 0.7; stroke-linecap: round; }
  .bf-club { fill: #6b3f1d; }

  /* Wings hinge at the body (88, 60). Near wings sweep up and down; the far wing counter-moves. */
  .bf-wing { transform-box: view-box; transform-origin: 88px 60px; }
  .bf-wing--near { animation: bf-near 0.2s ease-in-out infinite alternate; }
  .bf-wing--far { animation: bf-far 0.2s ease-in-out infinite alternate; }
  @keyframes bf-near { from { transform: rotate(26deg); } to { transform: rotate(-12deg); } }
  @keyframes bf-far { from { transform: rotate(-4deg); } to { transform: rotate(16deg); } }

  /* Perched: wings held up together, with an occasional slow open. */
  .butterfly.is-resting .bf-wing--near { animation: bf-near-rest 3.6s ease-in-out infinite; }
  .butterfly.is-resting .bf-wing--far { animation: bf-far-rest 3.6s ease-in-out infinite; }
  @keyframes bf-near-rest {
    0%, 72%, 100% { transform: rotate(50deg); }
    82% { transform: rotate(28deg); }
    92% { transform: rotate(50deg); }
  }
  @keyframes bf-far-rest {
    0%, 72%, 100% { transform: rotate(-8deg); }
    82% { transform: rotate(4deg); }
    92% { transform: rotate(-8deg); }
  }

  @media (prefers-reduced-motion: reduce) { .butterfly { display: none; } }
  @media print { .butterfly { display: none; } }
</style>

<script>
  const el = document.getElementById("butterfly") as HTMLElement | null;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (el && !reduce.matches) {
    const PERCH_SELECTOR =
      ".work-item, .project-card, .writing-pinned__link, .writing-row, .skill-group, .hero-link, .section-label, .hero-name";
    const REST_DELAY = 450; // ms after the last scroll event before landing
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    let x = rand(80, innerWidth - 80);
    let y = -40;
    let vx = 0;
    let vy = 0;
    let angle = 0; // degrees of tilt
    let face = 1; // 1 = facing right, -1 = facing left
    const svg = document.getElementById("butterfly-svg") as unknown as SVGElement;
    let target = { x, y };
    let mode: "perched" | "flying" | "landing" = "perched";
    let raf = 0;
    let restTimer = 0;
    let wanderAt = 0;
    let t0 = performance.now();

    const render = () => {
      el.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${angle}deg)`;
      svg.style.transform = `scaleX(${face})`;
    };

    const setResting = (resting: boolean) => el.classList.toggle("is-resting", resting);

    // A point on the top edge of a visible element, so it looks like sitting on it.
    const pickPerch = () => {
      const margin = 24;
      const candidates = [...document.querySelectorAll<HTMLElement>(PERCH_SELECTOR)]
        .map((n) => n.getBoundingClientRect())
        .filter(
          (r) =>
            r.width > 60 &&
            r.top > margin + 56 && // keep clear of the sticky nav
            r.top < innerHeight - 96 && // keep clear of the bottom dock on phones
            r.left < innerWidth - margin &&
            r.right > margin,
        );
      if (!candidates.length) return { x: rand(40, innerWidth - 40), y: rand(120, innerHeight - 110) };
      const r = candidates[Math.floor(Math.random() * candidates.length)];
      const left = Math.max(r.left, margin) + 12;
      const right = Math.min(r.right, innerWidth - margin) - 12;
      return { x: rand(left, Math.max(left, right)), y: r.top - 19 }; // feet touch the edge
    };

    const wanderPoint = () => ({ x: rand(30, innerWidth - 30), y: rand(80, innerHeight - 40) });

    const step = (now: number) => {
      const dt = Math.min((now - t0) / 16.67, 3);
      t0 = now;

      if (mode === "flying" && now > wanderAt) {
        target = wanderPoint();
        wanderAt = now + rand(500, 1100);
      }

      const dx = target.x - x;
      const dy = target.y - y;
      const dist = Math.hypot(dx, dy) || 1;
      const speed = mode === "landing" ? Math.min(5.5, 0.6 + dist * 0.07) : 4.2;
      // Steer toward the target with a little sinusoidal flutter.
      const wobble = mode === "flying" ? Math.sin(now / 140) * 1.1 : Math.sin(now / 200) * Math.min(dist / 80, 1);
      const nx = (dx / dist) * speed - (dy / dist) * wobble;
      const ny = (dy / dist) * speed + (dx / dist) * wobble;
      vx += (nx - vx) * 0.14 * dt;
      vy += (ny - vy) * 0.14 * dt;
      x += vx * dt;
      y += vy * dt;

      // Face the direction of travel and tilt the nose with vertical motion.
      if (Math.abs(vx) > 0.8) face = vx > 0 ? 1 : -1;
      const tilt = Math.max(-22, Math.min(22, vy * 4)) * face;
      angle += (tilt - angle) * 0.15 * dt;

      if (mode === "landing" && dist < 2.5) {
        mode = "perched";
        vx = vy = 0;
        x = target.x;
        y = target.y;
        // Settle facing either way, upright, wings closing.
        angle = rand(-5, 5);
        face = Math.random() < 0.5 ? 1 : -1;
        setResting(true);
        render();
        raf = 0;
        return;
      }
      render();
      raf = requestAnimationFrame(step);
    };

    const run = () => {
      if (!raf) {
        t0 = performance.now();
        raf = requestAnimationFrame(step);
      }
    };

    const onScroll = () => {
      if (mode !== "flying") {
        mode = "flying";
        setResting(false);
        target = wanderPoint();
        wanderAt = performance.now() + rand(500, 1100);
        run();
      }
      clearTimeout(restTimer);
      restTimer = window.setTimeout(() => {
        mode = "landing";
        target = pickPerch();
        run();
      }, REST_DELAY);
    };

    // Entrance: fade in perched on something visible once the page has settled.
    const start = () => {
      const p = pickPerch();
      x = p.x;
      y = p.y;
      angle = rand(-5, 5);
      face = Math.random() < 0.5 ? 1 : -1;
      setResting(true);
      render();
      el.classList.add("is-ready");
    };

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", () => {
      if (mode === "perched") {
        mode = "landing";
        target = pickPerch();
        run();
      }
    });
    reduce.addEventListener("change", () => {
      if (reduce.matches) {
        cancelAnimationFrame(raf);
        raf = 0;
        clearTimeout(restTimer);
      }
    });
    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>
