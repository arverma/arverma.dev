---
import { profile } from "../content/profile";
---

<section class="hero">
  <h1 class="hero-name">{profile.name}</h1>
  <p class="hero-role">Senior Data Engineer(SDE-III)</p>
  <p class="hero-bio">
    7+ Years building Data and AI Platforms. Currently at QuillBot, previously
    Flipkart and Sigmoid. B.Tech (Gold Medalist) · Executive MBA IIM Bodh Gaya '27.
    I write weekly on data engineering and mentor aspiring engineers.
  </p>
  <div class="hero-links">
    <button type="button" class="hero-link primary" data-resume-open>Resume</button>
    <a class="hero-link" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    <a class="hero-link" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a class="hero-link" href={profile.links.medium} target="_blank" rel="noopener noreferrer">Writing</a>
    <button type="button" class="hero-link" id="copy-email" data-email={profile.email}>Email</button>
  </div>
</section>

<!-- Toast notification -->
<div class="toast" id="copy-toast" role="status" aria-live="polite">
  <span class="toast-icon">✓</span> Copied to clipboard
</div>

<script>
  const btn = document.getElementById('copy-email') as HTMLButtonElement;
  const toast = document.getElementById('copy-toast') as HTMLElement;

  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email || '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      // Fallback for older browsers
      const ta = document.createElement('textarea');
      ta.value = email;
      ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }

    // Show toast
    toast.classList.add('is-visible');
    setTimeout(() => toast.classList.remove('is-visible'), 2200);
  });
</script>

<style>
  .hero {
    padding-block: 4rem;
    border-bottom: 1px solid var(--rule);
  }

  .hero-name {
    font-size: clamp(1.6rem, 5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .hero-role {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .hero-bio {
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.75;
    max-width: 520px;
    margin-bottom: 1.75rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-link {
    font-family: var(--mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 100px;
    color: var(--ink-2);
    text-decoration: none;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    line-height: inherit;
    font-family: var(--mono);
  }

  .hero-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
  }

  .hero-link.primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .hero-link.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
</style>

<style is:global>
  /* ── Toast ────────────────────────────────────────── */
  .toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(0.5rem);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 0.75rem;
    padding: 0.55rem 1.1rem;
    border-radius: 100px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 1000;
    white-space: nowrap;
  }

  .toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .toast-icon {
    color: #4ade80;
    font-size: 0.8rem;
  }
</style>
