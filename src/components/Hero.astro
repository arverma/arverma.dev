---
import { profile } from "../content/profile";
import Sticker from "./Sticker.astro";
import { withBase } from "../lib/paths";
---

<section class="hero section is-visible" aria-labelledby="hero-name">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 id="hero-name">{profile.name}</h1>
      <p class="hero-title">{profile.title}</p>
      <p class="hero-tagline">{profile.tagline}</p>
      <div class="btn-row hero-ctas">
        <button type="button" class="btn btn-primary" data-resume-open>
          Let's work Together!
        </button>
      </div>
      <p class="hero-meta mono">{profile.location}</p>
    </div>

    <div class="hero-desk">
      <div class="desk-plane">
        {/* Stickers behind the portrait — peek at edges only */}
        <Sticker
          src="/stickers/laptop.svg"
          size="sm"
          tilt="left"
          class="desk-sticker desk-sticker--main"
        />
        <Sticker
          src="/stickers/keyboard.svg"
          size="sm"
          tilt="right"
          class="desk-sticker desk-sticker--note"
        />
        <Sticker
          src="/stickers/coffee.svg"
          size="sm"
          tilt="left"
          class="desk-sticker desk-sticker--cup"
        />
        <div class="desk-sticker desk-sticker--me-wrap">
          <img
            class="desk-photo sticker"
            data-motion="drop"
            src={withBase("stickers/me.png")}
            alt={profile.name}
            width="2856"
            height="2572"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(1.5rem, 4vw, 3.25rem);
    border-bottom: 1px solid var(--rule);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: end;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6.5vw, 4.4rem);
    letter-spacing: -0.04em;
    max-width: 12ch;
  }

  .hero-title {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.8vw, 1.05rem);
    color: var(--ink-muted);
    max-width: 36rem;
  }

  .hero-tagline {
    margin: 1rem 0 0;
    max-width: 34rem;
    color: var(--ink);
  }

  .hero-ctas {
    margin-top: 1.75rem;
  }

  .hero-meta {
    margin: 1.25rem 0 0;
    font-size: 0.78rem;
    color: var(--ink-muted);
  }

  .hero-desk {
    min-height: clamp(16rem, 42vw, 22rem);
    width: 100%;
  }

  .desk-plane {
    position: relative;
    height: 100%;
    min-height: clamp(16rem, 42vw, 22rem);
    aspect-ratio: 1.05 / 1;
    max-height: 26rem;
    border-radius: 1.25rem 1.25rem 0.35rem 0.35rem;
    background:
      linear-gradient(180deg, rgba(232, 223, 208, 0.55), rgba(243, 236, 224, 0.2)),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 11px,
        rgba(28, 26, 22, 0.03) 11px,
        rgba(28, 26, 22, 0.03) 12px
      );
    border: 1.5px solid var(--rule);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
    overflow: visible;
  }

  /* Sticker imgs come from <Sticker />, so they never carry this
     component's scope hash and must be targeted globally. */
  .desk-plane :global(.desk-sticker) {
    position: absolute;
    z-index: 1;
  }

  /* Portrait ~95% of desk, above stickers */
  .desk-sticker--me-wrap {
    position: absolute;
    left: 2.5%;
    bottom: 0;
    top: auto;
    width: 95%;
    height: 95%;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
  }

  .desk-sticker--me-wrap .desk-photo {
    pointer-events: auto;
  }

  .desk-photo {
    --tilt: -2deg;
    --sticker-delay: 40ms;
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: contain;
    object-position: bottom center;
    background: transparent;
    border-radius: 0;
  }

  /* Edge peeks behind the portrait */
  .desk-plane :global(.desk-sticker--main) {
    top: -6%;
    left: -6%;
    right: auto;
    bottom: auto;
    width: clamp(5.25rem, 13.5vw, 7.5rem);
  }

  .desk-plane :global(.desk-sticker--note) {
    top: -5%;
    right: -6%;
    left: auto;
    bottom: auto;
    width: clamp(5.25rem, 13.5vw, 7.5rem);
  }

  .desk-plane :global(.desk-sticker--cup) {
    bottom: -4%;
    left: -6%;
    right: auto;
    top: auto;
    z-index: 3;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: none;
    }

    .hero-desk {
      order: -1;
      min-height: 0;
    }

    .desk-plane {
      min-height: 0;
      aspect-ratio: 1.15 / 1;
      max-height: 22rem;
      width: min(100%, 28rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 480px) {
    .desk-plane {
      max-height: 18rem;
    }

    .desk-plane :global(.desk-sticker--cup) {
      width: clamp(2.4rem, 15vw, 3.25rem);
    }

    .desk-plane :global(.desk-sticker--main),
    .desk-plane :global(.desk-sticker--note) {
      width: clamp(3.6rem, 22.5vw, 4.875rem);
    }
  }
</style>
