---
import { profile } from "../content/profile";
import { withBase } from "../lib/paths";
import Icon from "./Icon.astro";
---

<section class="hero">
  <div class="hero-top">
    <img class="hero-avatar" src={withBase("stickers/me.png")} alt={`Illustrated portrait of ${profile.name}`} width="88" height="88" />
    <div>
      <h1 class="hero-name">{profile.name}</h1>
      <p class="hero-hook"><span>I build data platforms.</span>{" "}<span>Then I write about what works.</span></p>
      <p class="hero-role"><Icon name="briefcase" size={14} />Senior Data Engineer (SDE-III)</p>
    </div>
  </div>
  <ul class="hero-meta">
    <li><Icon name="building" size={14} />QuillBot</li>
    <li><Icon name="map-pin" size={14} />Remote · India</li>
    <li><Icon name="award" size={14} />B.Tech Gold Medalist · IIIT Manipur</li>
    <li><Icon name="graduation-cap" size={14} />MBA · IIM Bodh Gaya '27</li>
  </ul>
  <p class="hero-bio">
    I'm a Senior Data Engineer at QuillBot, building data and AI platforms. Before that I
    worked on payments data at Flipkart and data engineering at Sigmoid. Along the way I fixed
    a{" "}<a href={profile.aboutLinks.kafka} target="_blank" rel="noopener noreferrer">Kafka Connect rebalance<span class="sr-only"> (opens in new tab)</span></a>{" "}that
    skipped 2.5 billion messages, repaired{" "}<a href={profile.aboutLinks.iceberg} target="_blank" rel="noopener noreferrer">corrupted Iceberg partitions<span class="sr-only"> (opens in new tab)</span></a>{" "}without
    data loss, and{" "}<a href={profile.aboutLinks.opensearch} target="_blank" rel="noopener noreferrer">downscaled a production OpenSearch cluster<span class="sr-only"> (opens in new tab)</span></a>{" "}without
    losing data. I write about these every week at Towards Data Engineering and mentor
    engineers getting into the field.
  </p>
  <div class="hero-links">
    <button type="button" class="hero-link primary" data-resume-open aria-haspopup="dialog">
      <Icon name="file-text" size={15} />Resume<Icon name="app-window" size={13} class="hint" />
      <span class="sr-only">(opens a preview dialog)</span>
    </button>
    <a class="hero-link" href={profile.links.github} target="_blank" rel="noopener noreferrer">
      <Icon name="github" size={15} />GitHub<Icon name="arrow-up-right" size={13} class="hint" />
      <span class="sr-only">(opens in new tab)</span>
    </a>
    <a class="hero-link" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
      <Icon name="linkedin" size={15} />LinkedIn<Icon name="arrow-up-right" size={13} class="hint" />
      <span class="sr-only">(opens in new tab)</span>
    </a>
    <a class="hero-link" href={profile.links.medium} target="_blank" rel="noopener noreferrer">
      <Icon name="pen-line" size={15} />Medium<Icon name="arrow-up-right" size={13} class="hint" />
      <span class="sr-only">(opens in new tab)</span>
    </a>
    <button type="button" class="hero-link" data-copy-email data-email={profile.email}>
      <Icon name="mail" size={15} />Email<Icon name="copy" size={13} class="hint" />
      <span class="sr-only">(copies address to clipboard)</span>
    </button>
  </div>
</section>

<!-- Toast notification -->
<div class="toast" id="copy-toast" role="status" aria-live="polite">
  <Icon name="check" size={14} class="toast-icon" /> Email address copied
</div>

<script>
  const toast = document.getElementById('copy-toast') as HTMLElement;

  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => btn.addEventListener('click', async () => {
    const email = btn.dataset.email || '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      // Fallback for older browsers
      const ta = document.createElement('textarea');
      ta.value = email;
      ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }

    // Show toast
    toast.classList.add('is-visible');
    setTimeout(() => toast.classList.remove('is-visible'), 2200);
  }));
</script>

<style is:global>
  /* ── Toast ────────────────────────────────────────── */
  .toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(0.5rem);
    background: var(--ink);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 0.75rem;
    padding: 0.55rem 1.1rem;
    border-radius: 100px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 1000;
    white-space: nowrap;
  }

  .toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .toast-icon {
    color: #4ade80;
    font-size: 0.8rem;
  }
</style>
