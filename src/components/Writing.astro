---
import Icon from "./Icon.astro";
import { getPosts, normalizeUrl } from "../lib/medium";
import { profile } from "../content/profile";

const pinnedUrls = new Set(profile.pinned.map((p) => normalizeUrl(p.url)));
// Fetch extra so the list still has 5 rows after the pinned posts are skipped.
const posts = (await getPosts(profile.pinned.length + 5))
  .filter((post) => !pinnedUrls.has(normalizeUrl(post.url)))
  .slice(0, 5);
---

<section class="section" id="writing">
  <h2 class="section-label"><Icon name="pen-line" size={14} />Writing</h2>
  <ul class="writing-pinned">
    {profile.pinned.map((p) => (
      <li>
        <a class="writing-pinned__link" href={p.url} target="_blank" rel="noopener noreferrer">
          <span class="writing-pinned__title">{p.title}<Icon name="arrow-up-right" size={18} class="ext" /></span>
          <span class="writing-pinned__hook">{p.hook}</span>
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </li>
    ))}
  </ul>
  <ul class="writing-list">
    {posts.map((post) => (
      <li>
        <a class="writing-row" href={post.url} target="_blank" rel="noopener noreferrer">
          <Icon name="file-text" size={16} class="writing-lead" />
          <span class="writing-row-title">{post.title}</span>
          <Icon name="arrow-up-right" size={16} class="ext" />
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="writing-actions">
    <a class="writing-all" href="/writing/">
      All writing <Icon name="arrow-right" size={14} />
    </a>
  </div>
</section>
