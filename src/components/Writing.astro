---
import { profile } from "../content/profile";
import Sticker from "./Sticker.astro";
---

<section class="section writing" id="writing" aria-labelledby="writing-title">
  <div class="section-head">
    <div>
      <p class="section-label">Writing</p>
      <h2 class="section-title" id="writing-title">Notes from the field</h2>
      <p class="section-lede">
        Weekly posts on Iceberg, platforms, and the unglamorous parts of data eng.
      </p>
    </div>
    <div class="section-stickers" aria-hidden="true">
      <Sticker src="/stickers/tea-cup.svg" size="sm" tilt="left" />
      <Sticker src="/stickers/coffee-alt.svg" size="sm" tilt="right" />
    </div>
  </div>

  <ul class="writing-list">
    {
      profile.writing.map((post) => (
        <li>
          <a
            class="writing-title"
            href={post.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {post.title}
          </a>
          <p class="writing-blurb">{post.blurb}</p>
        </li>
      ))
    }
  </ul>

  <p class="writing-more">
    <a
      class="mono"
      href={profile.links.medium}
      target="_blank"
      rel="noopener noreferrer">All posts on Medium →</a
    >
  </p>
</section>

<style>
  .writing-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .writing-list li {
    padding-block: 1.15rem;
    border-top: 1px solid var(--rule);
  }

  .writing-list li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .writing-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .writing-title:hover {
    color: var(--teal-deep);
    text-decoration: underline;
    text-decoration-color: var(--teal);
    text-underline-offset: 0.18em;
  }

  .writing-blurb {
    margin: 0.4rem 0 0;
    color: var(--ink-muted);
    max-width: 42rem;
  }

  .writing-more {
    margin: 1.5rem 0 0;
  }

  .writing-more a {
    font-size: 0.85rem;
    text-decoration: none;
  }

  .writing-more a:hover {
    text-decoration: underline;
  }
</style>
