---
import { profile } from "../content/profile";
import Parser from "rss-parser";

const parser = new Parser();
let posts = [];
try {
  // 5-second timeout so CI builds never hang if Medium is unreachable
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 5000);
  const feed = await parser.parseURL("https://medium.com/feed/@amanranjanverma", {
    requestOptions: { signal: controller.signal }
  });
  clearTimeout(timeout);
  posts = feed.items.slice(0, 5).map(item => ({
    title: item.title,
    url: item.link,
  }));
} catch {
  posts = profile.writing.map(p => ({ title: p.title, url: p.url }));
}
---

<section class="section" id="writing">
  <p class="section-label">Writing</p>
  <ul class="writing-list">
    {posts.map((post) => (
      <li>
        <a class="writing-row" href={post.url} target="_blank" rel="noopener noreferrer">
          <span class="writing-row-title">{post.title}</span>
          <span class="writing-arrow">↗</span>
        </a>
      </li>
    ))}
  </ul>
  <a class="writing-all" href={profile.links.medium} target="_blank" rel="noopener noreferrer">
    All posts →
  </a>
</section>
