---
import { profile } from "../content/profile";
import Icon from "./Icon.astro";
import Parser from "rss-parser";

type Post = { title: string; url: string };

const fallback: Post[] = profile.writing.map((p) => ({
  title: p.title,
  url: p.url,
}));

let posts: Post[] = fallback;

try {
  const response = await fetch("https://medium.com/feed/@amanranjanverma", {
    signal: AbortSignal.timeout(5000),
  });
  if (!response.ok) throw new Error(`RSS HTTP ${response.status}`);

  const feed = await new Parser().parseString(await response.text());
  const live = (feed.items ?? [])
    .slice(0, 5)
    .filter((item): item is typeof item & { title: string; link: string } =>
      Boolean(item.title && item.link),
    )
    .map((item) => ({ title: item.title, url: item.link }));

  if (live.length) posts = live;
} catch {
  // Keep curated fallback if Medium is unreachable during build/CI
}
---

<section class="section" id="writing">
  <h2 class="section-label"><Icon name="pen-line" size={14} />Writing</h2>
  <ul class="writing-list">
    {posts.map((post) => (
      <li>
        <a class="writing-row" href={post.url} target="_blank" rel="noopener noreferrer">
          <Icon name="file-text" size={16} class="writing-lead" />
          <span class="writing-row-title">{post.title}</span>
          <Icon name="arrow-up-right" size={16} class="ext" />
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="writing-actions">
    <a class="writing-all" href="/writing/">
      All writing <Icon name="arrow-right" size={14} />
    </a>
    <a class="writing-all" href={profile.links.medium} target="_blank" rel="noopener noreferrer">
      Medium profile <Icon name="arrow-up-right" size={14} />
      <span class="sr-only">(opens in new tab)</span>
    </a>
  </div>
</section>
