---
// Dark theme only: three to six fireflies (jugnu) on one canvas, behaving like the butterfly does in
// light mode. While the page scrolls they take off and wander the whole screen, flashing as they
// go; shortly after scrolling stops each one settles on the top edge of a visible card, where it
// keeps a slow, calm glow and the card picks up a faint aurora tint. Drawn with gradients and
// canvas paths only. aria-hidden, no pointer events, off for reduced motion and print.
---

<canvas class="fireflies" id="fireflies" aria-hidden="true"></canvas>

<style is:global>
  .fireflies {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 40;
    pointer-events: none;
    display: none;
  }
  [data-theme="dark"] .fireflies { display: block; }
  @media (prefers-reduced-motion: reduce) { .fireflies { display: none !important; } }
  @media print { .fireflies { display: none !important; } }
</style>

<script>
  const canvas = document.getElementById("fireflies") as HTMLCanvasElement | null;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const ctx = canvas?.getContext("2d") ?? null;

  if (canvas && ctx && !reduce.matches) {
    // 3 on phones, up to 6 on wide screens.
    const wantCount = () => clamp(Math.round(innerWidth / 220), 3, 6);
    // Cards first; if none is on screen (top of the page) a button will do. Never body text.
    const PERCH_SELECTOR = ".work-item, .project-card, .writing-row, .skill-group";
    const FALLBACK_SELECTOR = ".hero-link";
    const REST_DELAY = 450; // ms after the last scroll event before they settle
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
    const isDark = () => document.documentElement.dataset.theme !== "light";

    type Fly = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      face: number; // 1 right, -1 left
      tilt: number; // radians
      tx: number; // current waypoint (flying) or perch (landing/perched)
      ty: number;
      turnAt: number;
      speed: number; // px/frame-ish base, set per waypoint
      ph1: number;
      ph2: number;
      period: number; // seconds between flashes when perched
      phase: number;
      size: number;
      state: "flying" | "landing" | "perched";
      box: HTMLElement | null;
      rx: number;
    };

    let w = 0;
    let h = 0;
    let dpr = 1;
    const flies: Fly[] = [];
    let raf = 0;
    let last = 0;
    let startedAt = 0;
    let settleTimer = 0;
    const perchCount = new Map<HTMLElement, number>();

    const makeFly = (): Fly => ({
      x: rand(0, w),
      y: rand(120, h - 100),
      vx: 0,
      vy: 0,
      face: Math.random() < 0.5 ? 1 : -1,
      tilt: 0,
      tx: 0,
      ty: 0,
      turnAt: 0,
      speed: 70,
      ph1: rand(0, 6.28),
      ph2: rand(0, 6.28),
      period: rand(3.4, 5.6),
      phase: rand(0, 6),
      size: rand(1.25, 1.6),
      state: "flying",
      box: null,
      rx: 50,
    });

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = innerWidth;
      h = innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = wantCount();
      while (flies.length < n) flies.push(makeFly());
      while (flies.length > n) {
        const gone = flies.pop() as Fly;
        unmarkBox(gone.state === "perched" ? gone.box : null);
      }
      for (const f of flies) {
        f.x = clamp(f.x, 0, w);
        f.y = clamp(f.y, 0, h);
      }
    };

    // ── Perching ───────────────────────────────────────────
    const markBox = (box: HTMLElement | null, rx: number) => {
      if (!box) return;
      perchCount.set(box, (perchCount.get(box) ?? 0) + 1);
      box.style.setProperty("--bf-x", `${rx}%`);
      box.setAttribute("data-bf-perch", "");
    };
    const unmarkBox = (box: HTMLElement | null) => {
      if (!box) return;
      const n = (perchCount.get(box) ?? 1) - 1;
      if (n <= 0) {
        perchCount.delete(box);
        box.removeAttribute("data-bf-perch");
      } else {
        perchCount.set(box, n);
      }
    };

    const visibleBoxes = (selector: string) => {
      const margin = 24;
      return [...document.querySelectorAll<HTMLElement>(selector)]
        .map((box) => ({ box, r: box.getBoundingClientRect() }))
        .filter(
          ({ r }) =>
            r.width > 80 &&
            r.top > margin + 70 && // clear of the sticky nav
            r.top < h - 96 && // clear of the bottom dock on phones
            r.left < w - margin &&
            r.right > margin,
        );
    };

    // Each firefly picks its own spot along a card edge, in pairs per card.
    const assignPerches = (): boolean => {
      let boxes = visibleBoxes(PERCH_SELECTOR);
      if (!boxes.length) boxes = visibleBoxes(FALLBACK_SELECTOR);
      if (!boxes.length) return false;
      const pool = [...boxes].sort(() => Math.random() - 0.5);
      flies.forEach((f, i) => {
        // Fireflies like company: they settle two to a card, so only a few cards glow at once.
        const { box, r } = pool[Math.floor(i / 2) % pool.length];
        const left = Math.max(r.left, 24) + 14;
        const right = Math.min(r.right, w - 24) - 14;
        const px = rand(left, Math.max(left, right));
        f.tx = px;
        f.ty = r.top - 4;
        f.box = box;
        f.rx = clamp(((px - r.left) / r.width) * 100, 8, 92);
        f.state = "landing";
      });
      return true;
    };

    // After scrolling stops: land. If nothing suitable is on screen yet, keep drifting and look
    // again shortly, rather than ever settling over running text.
    const settle = (tries: number) => {
      if (!assignPerches() && tries < 6) settleTimer = window.setTimeout(() => settle(tries + 1), 700);
    };

    const takeOff = () => {
      for (const f of flies) {
        if (f.state !== "flying") {
          unmarkBox(f.state === "perched" ? f.box : null);
          f.state = "flying";
          f.box = null;
          f.vy = -rand(30, 55); // a small push upward as it lifts off
          f.vx = rand(-30, 30);
          f.turnAt = 0;
        }
      }
    };

    const onScroll = () => {
      if (!isDark()) return;
      takeOff();
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => settle(0), REST_DELAY);
    };

    // Next waypoint: somewhere across the whole width, favouring a different third than the one
    // it is in, so they roam the wide margins and not just the text column.
    const nextWaypoint = (f: Fly, now: number) => {
      const span = w - 80;
      const band = (px: number) => clamp(Math.floor(((px - 40) / span) * 3), 0, 2);
      const here = band(f.x);
      const others = [0, 1, 2].filter((b) => b !== here);
      const next = Math.random() < 0.7 ? others[Math.floor(Math.random() * others.length)] : here;
      f.tx = 40 + ((next + Math.random()) / 3) * span;
      f.ty = rand(120, Math.max(200, h - 110));
      f.turnAt = now + rand(1100, 2300);
      // Fireflies are unhurried; wider screens get a little more speed so they can cross the page.
      f.speed = rand(55, 105) * clamp(w / 900, 0.85, 1.5);
    };

    // ── Update ─────────────────────────────────────────────
    const update = (dt: number, now: number) => {
      const t = now / 1000;
      for (const f of flies) {
        let desiredVx = 0;
        let desiredVy = 0;
        let accel = 2.2;
        if (f.state === "flying") {
          if (now > f.turnAt) nextWaypoint(f, now);
          const dx = f.tx - f.x;
          const dy = f.ty - f.y;
          const dist = Math.hypot(dx, dy) || 1;
          desiredVx = (dx / dist) * f.speed;
          desiredVy = (dy / dist) * f.speed;
          // Meandering lilt: a slow sideways weave plus a gentle bob, as they float rather than dash.
          const weave = Math.sin(t * 1.3 + f.ph1) * 26;
          desiredVx += (-dy / dist) * weave;
          desiredVy += (dx / dist) * weave + Math.sin(t * 2.6 + f.ph2) * 20;
          f.x += f.vx * dt;
          f.y += f.vy * dt;
        } else if (f.state === "landing") {
          const dx = f.tx - f.x;
          const dy = f.ty - f.y;
          const dist = Math.hypot(dx, dy) || 1;
          // Drift in, slowing as it nears, with a little hover-sway on the approach.
          const sp = clamp(26 + dist * 1.1, 20, 150);
          const sway = Math.sin(t * 3 + f.ph1) * 22 * Math.min(dist / 90, 1);
          desiredVx = (dx / dist) * sp + (-dy / dist) * sway;
          desiredVy = (dy / dist) * sp + (dx / dist) * sway;
          accel = 3.2;
          f.x += f.vx * dt;
          f.y += f.vy * dt;
          if (dist < 2) {
            f.state = "perched";
            f.x = f.tx;
            f.y = f.ty;
            f.vx = f.vy = 0;
            markBox(f.box, f.rx);
          }
        }
        if (f.state !== "perched") {
          f.vx += (desiredVx - f.vx) * Math.min(1, accel * dt);
          f.vy += (desiredVy - f.vy) * Math.min(1, accel * dt);
          if (Math.abs(f.vx) > 8) f.face = f.vx > 0 ? 1 : -1;
          const tiltTarget = clamp((f.vy / 90) * f.face, -0.5, 0.5);
          f.tilt += (tiltTarget - f.tilt) * Math.min(1, 6 * dt);
        } else {
          f.tilt += (0 - f.tilt) * Math.min(1, 4 * dt);
        }
      }
    };

    // ── Draw ───────────────────────────────────────────────
    // In flight a firefly blinks quickly; sitting, it pulses slowly with a long, soft glow.
    const brightness = (f: Fly, now: number) => {
      const perched = f.state === "perched";
      const period = perched ? f.period : f.period * 0.36;
      const t = ((((now / 1000 + f.phase) % period) + period) % period) / period;
      const span = perched ? 0.55 : 0.4;
      const flash = t < span ? Math.sin((Math.PI * t) / span) ** 2 : 0;
      return (perched ? 0.12 : 0.08) + (perched ? 0.88 : 0.92) * flash;
    };

    const draw = (now: number) => {
      ctx.clearRect(0, 0, w, h);
      const fade = clamp((now - startedAt) / 1800, 0, 1); // ease in on load / theme switch
      for (const f of flies) {
        const b = brightness(f, now) * fade;
        const perched = f.state === "perched";
        const s = f.size;

        // Glow
        const r = 28 * s * (0.45 + 0.55 * b);
        ctx.globalCompositeOperation = "lighter";
        const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, r);
        g.addColorStop(0, `rgba(232, 255, 130, ${0.8 * b + 0.04})`);
        g.addColorStop(0.28, `rgba(190, 255, 90, ${0.32 * b})`);
        g.addColorStop(1, "rgba(120, 255, 80, 0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(f.x, f.y, r, 0, Math.PI * 2);
        ctx.fill();

        // Body: a tiny beetle, abdomen aglow. Faces the way it travels.
        ctx.globalCompositeOperation = "source-over";
        ctx.save();
        ctx.translate(f.x, f.y);
        ctx.scale(f.face, 1);
        ctx.rotate(f.tilt);
        const flap = perched ? -0.15 : -0.45 + Math.sin(now * 0.05 + f.ph1) * 0.55;
        ctx.fillStyle = "rgba(205, 225, 255, 0.2)"; // wings
        ctx.beginPath();
        ctx.ellipse(-0.6 * s, -1.4 * s, 3.1 * s, 1 * s, flap, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "#11160e"; // body
        ctx.beginPath();
        ctx.ellipse(0, 0, 3.3 * s, 1.35 * s, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath(); // head
        ctx.arc(3.5 * s, 0.1 * s, 1 * s, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "rgba(235, 100, 150, 0.7)"; // pink collar
        ctx.beginPath();
        ctx.arc(1.7 * s, 0, 1.15 * s, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(236, 255, 140, ${0.22 + 0.78 * b})`; // glowing abdomen
        ctx.beginPath();
        ctx.ellipse(-2.9 * s, 0.2 * s, 1.7 * s, 1.2 * s, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    };

    // ── Loop ───────────────────────────────────────────────
    const frame = (now: number) => {
      if (!isDark()) {
        stop();
        return;
      }
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      update(dt, now);
      draw(now);
      raf = requestAnimationFrame(frame);
    };

    const release = () => {
      clearTimeout(settleTimer);
      for (const f of flies) {
        unmarkBox(f.state === "perched" ? f.box : null);
        f.state = "flying";
        f.box = null;
      }
    };

    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      release();
      ctx.clearRect(0, 0, w, h);
    };

    const start = () => {
      if (raf || !isDark()) return;
      resize();
      startedAt = performance.now();
      last = startedAt;
      for (const f of flies) f.turnAt = 0;
      raf = requestAnimationFrame(frame);
      // Like the butterfly, begin by sitting on something visible.
      settle(0);
    };

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", () => {
      if (!raf) return;
      release();
      resize();
      settle(0);
    });
    new MutationObserver(() => (isDark() ? start() : stop())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    reduce.addEventListener("change", () => reduce.matches && stop());

    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>
