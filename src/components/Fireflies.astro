---
// Dark theme only: a handful of fireflies (jugnu) drifting over the page on one canvas.
// Each one wanders on its own path and flashes warm yellow-green on its own rhythm. When the
// page scrolls they scatter; shortly after scrolling stops a few settle on the top edge of a
// visible card, which picks up a faint aurora tint. All drawn with gradients and canvas paths,
// no images. aria-hidden, no pointer events, off for reduced motion and print.
---

<canvas class="fireflies" id="fireflies" aria-hidden="true"></canvas>

<style is:global>
  .fireflies {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 40;
    pointer-events: none;
    display: none;
  }
  [data-theme="dark"] .fireflies { display: block; }
  @media (prefers-reduced-motion: reduce) { .fireflies { display: none !important; } }
  @media print { .fireflies { display: none !important; } }
</style>

<script>
  const canvas = document.getElementById("fireflies") as HTMLCanvasElement | null;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const ctx = canvas?.getContext("2d") ?? null;

  if (canvas && ctx && !reduce.matches) {
    const PERCH_SELECTOR = ".work-item, .project-card, .writing-row, .skill-group";
    const REST_DELAY = 450; // ms after the last scroll event before some settle
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
    const isDark = () => document.documentElement.dataset.theme !== "light";

    type Fly = {
      x: number;
      y: number;
      heading: number; // radians
      speed: number; // idle px/s
      f1: number;
      f2: number;
      ph1: number;
      ph2: number;
      period: number; // seconds between flashes
      phase: number;
      size: number;
      state: "drift" | "landing" | "perched";
      tx: number;
      ty: number;
      box: HTMLElement | null;
      rx: number;
    };

    let w = 0;
    let h = 0;
    let dpr = 1;
    let flies: Fly[] = [];
    let raf = 0;
    let last = 0;
    let lastScroll = -1e9;
    let settleTimer = 0;
    let startedAt = 0;
    const perchCount = new Map<HTMLElement, number>();

    const makeFly = (): Fly => ({
      x: rand(0, w),
      y: rand(80, h),
      heading: rand(0, Math.PI * 2),
      speed: rand(10, 24),
      f1: rand(0.4, 0.9),
      f2: rand(0.9, 1.7),
      ph1: rand(0, 6.28),
      ph2: rand(0, 6.28),
      period: rand(2.6, 5.6),
      phase: rand(0, 6),
      size: rand(1.2, 1.7),
      state: "drift",
      tx: 0,
      ty: 0,
      box: null,
      rx: 50,
    });

    const wantCount = () => clamp(Math.round(innerWidth / 105), 6, 16);

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = innerWidth;
      h = innerHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = wantCount();
      while (flies.length < n) flies.push(makeFly());
      if (flies.length > n) flies.length = n;
      for (const f of flies) {
        f.x = clamp(f.x, 0, w);
        f.y = clamp(f.y, 0, h);
      }
    };

    // ── Perching ───────────────────────────────────────────
    const markBox = (box: HTMLElement | null, rx: number) => {
      if (!box) return;
      perchCount.set(box, (perchCount.get(box) ?? 0) + 1);
      box.style.setProperty("--bf-x", `${rx}%`);
      box.setAttribute("data-bf-perch", "");
    };
    const unmarkBox = (box: HTMLElement | null) => {
      if (!box) return;
      const n = (perchCount.get(box) ?? 1) - 1;
      if (n <= 0) {
        perchCount.delete(box);
        box.removeAttribute("data-bf-perch");
      } else {
        perchCount.set(box, n);
      }
    };

    const visibleBoxes = () => {
      const margin = 24;
      return [...document.querySelectorAll<HTMLElement>(PERCH_SELECTOR)]
        .map((box) => ({ box, r: box.getBoundingClientRect() }))
        .filter(
          ({ r }) =>
            r.width > 80 &&
            r.top > margin + 70 && // clear of the sticky nav
            r.top < h - 96 && // clear of the bottom dock on phones
            r.left < w - margin &&
            r.right > margin,
        );
    };

    // After scrolling stops, a few fireflies settle on the top edge of visible cards.
    const settle = () => {
      const boxes = visibleBoxes();
      if (!boxes.length) return;
      const drifting = flies.filter((f) => f.state === "drift").sort(() => Math.random() - 0.5);
      const take = Math.min(drifting.length, Math.max(2, Math.round(flies.length * 0.3)));
      for (let i = 0; i < take; i++) {
        const { box, r } = boxes[Math.floor(Math.random() * boxes.length)];
        const left = Math.max(r.left, 24) + 14;
        const right = Math.min(r.right, w - 24) - 14;
        const px = rand(left, Math.max(left, right));
        const f = drifting[i];
        f.state = "landing";
        f.tx = px;
        f.ty = r.top - 4;
        f.box = box;
        f.rx = clamp(((px - r.left) / r.width) * 100, 8, 92);
      }
    };

    const scatter = (now: number) => {
      lastScroll = now;
      for (const f of flies) {
        if (f.state !== "drift") {
          unmarkBox(f.state === "perched" ? f.box : null);
          f.state = "drift";
          f.box = null;
          f.heading = -Math.PI / 2 + rand(-1.1, 1.1); // push off upward
        }
      }
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(settle, REST_DELAY);
    };

    // ── Update ─────────────────────────────────────────────
    const angleDiff = (a: number, b: number) => ((b - a + Math.PI * 3) % (Math.PI * 2)) - Math.PI;

    const update = (dt: number, now: number) => {
      const excite = clamp(1 - (now - lastScroll) / 1400, 0, 1); // fresh scroll, quicker flight
      const t = now / 1000;
      for (const f of flies) {
        if (f.state === "drift") {
          f.heading += (Math.sin(t * f.f1 + f.ph1) * 0.9 + Math.sin(t * f.f2 + f.ph2) * 0.55) * dt;
          const margin = 40;
          if (f.x < margin || f.x > w - margin || f.y < 90 || f.y > h - 60) {
            const toCentre = Math.atan2(h * 0.55 - f.y, w * 0.5 - f.x);
            f.heading += angleDiff(f.heading, toCentre) * Math.min(1, 2.2 * dt);
          }
          const sp = f.speed * (1 + 3.2 * excite);
          f.x += Math.cos(f.heading) * sp * dt;
          f.y += Math.sin(f.heading) * sp * dt + Math.sin(t * 2.1 + f.ph2) * 7 * dt;
        } else if (f.state === "landing") {
          const dx = f.tx - f.x;
          const dy = f.ty - f.y;
          const dist = Math.hypot(dx, dy) || 1;
          const sp = clamp(40 + dist * 1.6, 28, 240);
          const step = Math.min(dist, sp * dt);
          f.x += (dx / dist) * step + Math.sin(t * 5 + f.ph1) * 12 * dt * Math.min(dist / 80, 1);
          f.y += (dy / dist) * step;
          f.heading = Math.atan2(dy, dx);
          if (dist < 2) {
            f.state = "perched";
            f.x = f.tx;
            f.y = f.ty;
            markBox(f.box, f.rx);
          }
        }
      }
    };

    // ── Draw ───────────────────────────────────────────────
    // A flash: smooth rise and fall over ~40% of the period, a faint ember the rest of the time.
    const brightness = (f: Fly, now: number) => {
      const t = (((now / 1000 + f.phase) % f.period) + f.period) % f.period / f.period;
      const flash = t < 0.4 ? Math.sin((Math.PI * t) / 0.4) ** 2 : 0;
      return 0.08 + 0.92 * flash;
    };

    const draw = (now: number) => {
      ctx.clearRect(0, 0, w, h);
      const fade = clamp((now - startedAt) / 1800, 0, 1); // ease in on load / theme switch
      for (const f of flies) {
        const b = brightness(f, now) * fade;
        const perched = f.state === "perched";
        const s = f.size;

        // Glow
        const r = 26 * s * (0.45 + 0.55 * b);
        ctx.globalCompositeOperation = "lighter";
        const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, r);
        g.addColorStop(0, `rgba(232, 255, 130, ${0.8 * b + 0.04})`);
        g.addColorStop(0.28, `rgba(190, 255, 90, ${0.32 * b})`);
        g.addColorStop(1, "rgba(120, 255, 80, 0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(f.x, f.y, r, 0, Math.PI * 2);
        ctx.fill();

        // Body: a tiny beetle, abdomen aglow. Faces the way it travels.
        ctx.globalCompositeOperation = "source-over";
        ctx.save();
        ctx.translate(f.x, f.y);
        const face = Math.cos(f.heading) >= 0 ? 1 : -1;
        ctx.scale(face, 1);
        ctx.rotate(perched ? 0 : clamp(Math.sin(f.heading) * 0.5, -0.5, 0.5));
        const flap = perched ? -0.15 : -0.45 + Math.sin(now * 0.05 + f.ph1) * 0.55;
        ctx.fillStyle = "rgba(205, 225, 255, 0.2)"; // wings
        ctx.beginPath();
        ctx.ellipse(-0.6 * s, -1.4 * s, 3.1 * s, 1 * s, flap, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "#11160e"; // body
        ctx.beginPath();
        ctx.ellipse(0, 0, 3.3 * s, 1.35 * s, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath(); // head
        ctx.arc(3.5 * s, 0.1 * s, 1 * s, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "rgba(235, 100, 150, 0.7)"; // pink collar
        ctx.beginPath();
        ctx.arc(1.7 * s, 0, 1.15 * s, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = `rgba(236, 255, 140, ${0.22 + 0.78 * b})`; // glowing abdomen
        ctx.beginPath();
        ctx.ellipse(-2.9 * s, 0.2 * s, 1.7 * s, 1.2 * s, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    };

    // ── Loop ───────────────────────────────────────────────
    const frame = (now: number) => {
      if (!isDark()) {
        stop();
        return;
      }
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      update(dt, now);
      draw(now);
      raf = requestAnimationFrame(frame);
    };

    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      clearTimeout(settleTimer);
      for (const f of flies) {
        unmarkBox(f.state === "perched" ? f.box : null);
        f.state = "drift";
        f.box = null;
      }
      ctx.clearRect(0, 0, w, h);
    };

    const start = () => {
      if (raf || !isDark()) return;
      resize();
      startedAt = performance.now();
      last = startedAt;
      raf = requestAnimationFrame(frame);
    };

    addEventListener("scroll", () => isDark() && scatter(performance.now()), { passive: true });
    addEventListener("resize", () => {
      if (!raf) return;
      for (const f of flies) {
        unmarkBox(f.state === "perched" ? f.box : null);
        f.state = "drift";
        f.box = null;
      }
      resize();
    });
    new MutationObserver(() => (isDark() ? start() : stop())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    reduce.addEventListener("change", () => reduce.matches && stop());

    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>
