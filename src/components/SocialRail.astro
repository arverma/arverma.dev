---
import { profile } from "../content/profile";
import { withBase } from "../lib/paths";

const socials = [
  {
    label: "LinkedIn",
    href: profile.links.linkedin,
    icon: withBase("socials/linkedin.svg"),
  },
  {
    label: "GitHub",
    href: profile.links.github,
    icon: withBase("socials/github.svg"),
  },
  {
    label: "Medium",
    href: profile.links.medium,
    icon: withBase("socials/medium.svg"),
  },
] as const;
---

<nav class="social-rail" aria-label="Social links">
  <ul class="social-rail__list">
    {
      socials.map((social) => (
        <li>
          <a
            class="social-rail__link"
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
            title={social.label}
          >
            <img
              class="social-rail__icon"
              src={social.icon}
              alt=""
              width="28"
              height="28"
              decoding="async"
            />
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .social-rail {
    position: fixed;
    right: clamp(0.55rem, 1.8vw, 1.1rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
  }

  .social-rail__list {
    list-style: none;
    margin: 0;
    padding: 0.55rem 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: center;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border: 1px solid var(--rule);
    border-radius: 999px;
    box-shadow: 0 6px 18px rgba(28, 26, 22, 0.08);
  }

  .social-rail__link {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .social-rail__link:hover,
  .social-rail__link:focus-visible {
    transform: translateY(-2px) scale(1.06);
    background: color-mix(in srgb, var(--teal) 12%, transparent);
    outline: none;
  }

  .social-rail__icon {
    width: 1.35rem;
    height: 1.35rem;
    object-fit: contain;
    display: block;
    filter: none;
  }

  /* Vertically centred rail would sit on top of the hero portrait once the
     desk goes full-bleed, so dock it to the corner instead. */
  @media (max-width: 800px) {
    .social-rail {
      right: 0.55rem;
      top: auto;
      bottom: 0.9rem;
      transform: none;
    }

    .social-rail__list {
      flex-direction: column;
      padding: 0.4rem 0.3rem;
      gap: 0.55rem;
    }

    .social-rail__link {
      width: 2rem;
      height: 2rem;
    }

    .social-rail__icon {
      width: 1.15rem;
      height: 1.15rem;
    }
  }
</style>
